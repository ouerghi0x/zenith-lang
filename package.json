{
  "name": "zenith-lang",
  "displayName": "Zenith Language Support",
  "version": "1.0.2",
  "publisher": "zenith",
  "main": "./extension.js",
  "activationEvents": [
    "onLanguage:zenith"
  ],
  "contributes": {
    "languages": [
      {
        "id": "zenith",
        "aliases": ["Zenith", "zenith"],
        "extensions": [".zen"],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./icons/zenith.svg",
          "dark": "./icons/zenith.svg"
        }
      }
    ],
    "grammars": [
      {
        "language": "zenith",
        "scopeName": "source.zenith",
        "path": "./syntaxes/zenith.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "zenith.run",
        "title": "Zenith: Run Backend",
        "icon": "$(play)"
      },
      {
        "command": "zenith.studio",
        "title": "Zenith: Open Studio",
        "icon": "$(browser)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "zenith.run",
          "when": "editorLangId == zenith",
          "group": "navigation@1"
        },
        {
          "command": "zenith.studio",
          "when": "editorLangId == zenith",
          "group": "navigation@2"
        }
      ]
    }
  }
}
