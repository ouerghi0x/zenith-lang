{
  "name": "zenith-lang",
  "displayName": "Zenith Language Support",
  "description": "Syntax highlighting, custom logo icons, and build tools for Zenith DSL",
  "version": "1.0.3",
  "publisher": "zenith",
  "main": "./extension.js",
  "activationEvents": [
    "onLanguage:zenith"
  ],
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Programming Languages",
    "Snippets"
  ],
  "contributes": {
    "languages": [
      {
        "id": "zenith",
        "aliases": ["Zenith", "zenith"],
        "extensions": [".zen"],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./icons/zenith.svg",
          "dark": "./icons/zenith.svg"
        }
      }
    ],
    "grammars": [
      {
        "language": "zenith",
        "scopeName": "source.zenith",
        "path": "./syntaxes/zenith.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "zenith.run",
        "title": "Zenith: Build Backend",
        "icon": "$(play)"
      },
      {
        "command": "zenith.studio",
        "title": "Zenith: Open Studio",
        "icon": "$(globe)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "zenith.run",
          "when": "editorLangId == zenith",
          "group": "navigation@1"
        },
        {
          "command": "zenith.studio",
          "when": "editorLangId == zenith",
          "group": "navigation@2"
        }
      ]
    },
    "iconThemes": [
      {
        "id": "zenith-icons",
        "label": "Zenith File Icons",
        "path": "./icons/icon-theme.json"
      }
    ]
  }
}
