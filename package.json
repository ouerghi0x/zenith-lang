{
  "name": "zenith",
  "displayName": "Zenith Language Support",
  "description": "Rich syntax highlighting, snippets, and auto-completion for Zenith DSL",
  "version": "1.0.0",
  "publisher": "zenith-dsl",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Programming Languages",
    "Snippets"
  ],
  "contributes": {
    "languages": [
      {
        "id": "zenith",
        "aliases": ["Zenith", "zenith", "zen"],
        "extensions": [".zen"],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "zenith",
        "scopeName": "source.zenith",
        "path": "./syntaxes/zenith.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "zenith",
        "path": "./snippets/zenith.json"
      }
    ]
  }
}
