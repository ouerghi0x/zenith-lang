{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Zenith",
  "scopeName": "source.zenith",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#keywords" },
    { "include": "#decorators" },
    { "include": "#types" },
    { "include": "#operators" },
    { "include": "#punctuation" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.zenith",
          "match": "//.*$"
        },
        {
          "name": "comment.block.zenith",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.zenith",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.zenith",
              "match": "\\\\."
            }
          ]
        },
        {
          "name": "string.quoted.single.zenith",
          "begin": "'",
          "end": "'",
          "patterns": [
            {
              "name": "constant.character.escape.zenith",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.zenith",
          "match": "\\b\\d+(\\.\\d+)?\\b"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.zenith",
          "match": "\\b(config|model|enum|relations|endpoints|crud|guard|action)\\b"
        },
        {
          "name": "keyword.other.http.zenith",
          "match": "\\b(get|post|put|delete|patch)\\b"
        },
        {
          "name": "keyword.other.auth.zenith",
          "match": "\\b(auth|public)\\b"
        },
        {
          "name": "constant.language.boolean.zenith",
          "match": "\\b(true|false)\\b"
        }
      ]
    },
    "decorators": {
      "patterns": [
        {
          "name": "entity.name.tag.decorator.zenith",
          "match": "@[a-zA-Z_][a-zA-Z0-9_]*"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "support.type.primitive.zenith",
          "match": "\\b(String|Int|Integer|Long|Decimal|BigDecimal|Double|Float|Boolean|Bool|DateTime|LocalDateTime|LocalDate|Date|UUID|List)\\b"
        },
        {
          "name": "entity.name.type.class.zenith",
          "match": "\\b[A-Z][a-zA-Z0-9_]*\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.zenith",
          "match": "(->|==|!=|<=|>=|&&|\\|\\||!|=|<|>|\\?|:)"
        }
      ]
    },
    "punctuation": {
      "patterns": [
        {
          "name": "punctuation.separator.zenith",
          "match": "[,.]"
        },
        {
          "name": "punctuation.section.brackets.zenith",
          "match": "[\\[\\]\\{\\}\\(\\)]"
        }
      ]
    }
  }
}
