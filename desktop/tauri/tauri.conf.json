{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/tooling/cli/schema.json",
  "build": {
    "devPath": "http://localhost:3000",
    "distDir": "http://localhost:3000"
  },
  "package": {
    "productName": "Zenith Studio",
    "version": "1.0.0"
  },
  "tauri": {
    "windows": [
      {
        "title": "Zenith Studio PRO",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "bundle": {
      "active": true,
      "targets": ["nsis", "msi"],
      "identifier": "dev.zenith.studio",
      "icon": ["icon.png"]
    },
    "security": {
      "csp": null
    }
  }
}

