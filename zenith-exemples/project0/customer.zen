enum UserRole {
    ADMIN,
    CUSTOMER
}
model Customer {
    id: UUID @id @auto
    email: String @email @unique
    password: String @password
    role: UserRole = CUSTOMER @role
    fullName: String(min = 2, max = 100)
    createdAt: DateTime @autoNow

    relations {
        orders: List<Order> @relation(oneToMany, mappedBy = "customer")
    }
}