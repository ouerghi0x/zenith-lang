config {
    app: "ShopSphere"
    package: "com.shopsphere.backend"
    basePath: "/api/v1"
    port: 8080
    database: postgres // replace it with h2 if u dont have postgres running 
    springBootVersion: "3.2.5"
    javaVersion: 17
    auth: jwt
    swagger: true
    flyway: true
}

enum UserRole {
    ADMIN,
    CUSTOMER
}

enum OrderStatus {
    PENDING,
    PAID,
    SHIPPED,
    DELIVERED,
    CANCELLED
}

enum ProductStatus {
    DRAFT,
    ACTIVE,
    OUT_OF_STOCK,
    ARCHIVED
}

model Category {
    id: Long @id @auto
    name: String(min = 2, max = 60) @unique
    description: String? @text
    createdAt: DateTime @autoNow

    relations {
        products: List<Product> @relation(oneToMany, mappedBy = "category")
    }

    endpoints {
        crud {
            paginate: true
            sort: [name, createdAt]
        }
    }
}

model Product {
    id: Long @id @auto
    sku: String(length = 32) @unique
    name: String(min = 3, max = 150)
    description: String? @text
    price: Decimal(precision = 12, scale = 2) @positive
    stock: Int @min(0) = 0
    status: ProductStatus = ACTIVE
    createdAt: DateTime @autoNow
    updatedAt: DateTime @autoUpdate

    relations {
        category: Category @relation(manyToOne)
    }

    endpoints {
        crud {
            paginate: true
            search: [name, sku]
            filter: [status]
            sort: [price, createdAt]
        }

        post "/{id}/archive" -> ProductResponse {
            description: "Archives a product from the catalog"
            guard: status != ProductStatus.ARCHIVED, "Product is already archived"
            action: {
                status = ProductStatus.ARCHIVED,
                stock = 0
            }
        }
    }
}

model Customer {
    id: Long @id @auto
    firstName: String(min = 2, max = 50)
    lastName: String(min = 2, max = 50)
    email: String(max = 100) @unique @email
    password: String @password
    role: UserRole = CUSTOMER @role
    phone: String?
    createdAt: DateTime @autoNow

    relations {
        orders: List<Order> @relation(oneToMany, mappedBy = "customer")
    }

    endpoints {
        crud {
            paginate: true
            search: [firstName, lastName, email]
            sort: [lastName, createdAt]
        }
    }
}

model Order {
    id: Long @id @auto
    orderNumber: String(length = 36) @unique
    totalAmount: Decimal(precision = 12, scale = 2) @positive
    status: OrderStatus = PENDING
    notes: String? @text
    createdAt: DateTime @autoNow
    updatedAt: DateTime @autoUpdate

    relations {
        customer: Customer @relation(manyToOne)
    }

    endpoints {
        crud {
            paginate: true
            search: [orderNumber]
            filter: [status]
            sort: [createdAt, totalAmount]
        }

        post "/{id}/cancel" -> OrderResponse {
            description: "Cancels an order and releases reserved inventory"
            guard: status != OrderStatus.DELIVERED, "Delivered orders cannot be cancelled"
            action: {
                status = OrderStatus.CANCELLED
            }
        }

        post "/{id}/ship" -> OrderResponse {
            description: "Marks an order as shipped"
            guard: status == OrderStatus.PAID, "Only paid orders can be shipped"
            action: {
                status = OrderStatus.SHIPPED
            }
        }
    }
}
